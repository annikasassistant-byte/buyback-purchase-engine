# Copy this file to `.env` and fill in real values (Neon dashboard -> Connect
# for the DB vars). `.env` is gitignored - never commit real credentials.
# Loaded automatically by both the CLI and the API via `python-dotenv` (part
# of the `postgres`/`api` extras: `pip install -e ".[api]"`).

# --- Postgres (Neon) ---------------------------------------------------
# Direct connection - one long-lived connection per process. Used by the
# batch CLI: `python -m purchase_engine --postgres`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Pooled connection (PgBouncer) - many short-lived connections, one per HTTP
# request. Used by the API (`purchase_engine.api.app`).
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&channel_binding=require"

# --- API (purchase_engine.api) ------------------------------------------
# Shared-secret the frontend sends as the `X-API-Key` header. Leave unset for
# local dev (every endpoint is then unauthenticated - a log warning says so
# on startup); ALWAYS set it anywhere this API is actually deployed.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=""

# Comma-separated browser origins allowed to call this API (CORS). Add the
# Vercel frontend's URL(s) once deployed, e.g.:
# CORS_ORIGINS="http://localhost:3000,https://your-app.vercel.app"
CORS_ORIGINS="http://localhost:3000"

# Optional: force a specific workbook path instead of auto-discovery
# (`find_default_workbook()`). Usually unnecessary - the shipped sample
# dataset auto-discovers fine from the repo root.
WORKBOOK_PATH=""

# --- Neon Auth -----------------------------------------------------------
# Not consumed by this repo - it's sign-in for the *frontend*, not this
# Python API. Documented here only so both repos can copy .env from the same
# Neon project page.
NEON_AUTH_BASE_URL=""
