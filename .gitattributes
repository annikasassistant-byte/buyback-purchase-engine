# Normalise line endings
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary / vendored - don't diff, don't touch
*.xlsx binary
*.png binary
*.ico binary

